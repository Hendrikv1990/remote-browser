#!/usr/bin/env node
import { loadConfig } from '../src/config.mjs';
import { makeDeps } from '../src/deps.mjs';
import { up } from '../src/commands/up.mjs';
import { down } from '../src/commands/down.mjs';
import { status } from '../src/commands/status.mjs';

const cfg = loadConfig();
const deps = makeDeps(cfg);

const cmds = { up, down, status };
const name = process.argv[2];
if (name === 'init') {
  const { init } = await import('../src/commands/init.mjs');
  const rl = (await import('node:readline/promises')).createInterface({ input: process.stdin, output: process.stdout });
  await init({ ...deps, confirm: async (q) => /^y(es)?$/i.test((await rl.question(`${q} [y/N] `)).trim()) });
  rl.close();
} else if (cmds[name]) {
  await cmds[name](deps);
} else {
  console.error('usage: remote-browser <init|up|down|status>');
  process.exit(2);
}
