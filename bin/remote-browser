#!/usr/bin/env node
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { loadConfig } from '../src/config.mjs';
import { makeAws } from '../src/aws.mjs';
import { probeCdp } from '../src/mode.mjs';
import { readState } from '../src/state.mjs';
import { socketPath } from '../src/tunnel.mjs';
import { up } from '../src/commands/up.mjs';
import { down } from '../src/commands/down.mjs';
import { status } from '../src/commands/status.mjs';

const execFileP = promisify(execFile);
const cfg = loadConfig();
const deps = {
  cfg,
  aws: makeAws(cfg),
  ssh: async (args) => (await execFileP('ssh', args)).stdout,
  probe: probeCdp,
  myIp: async () => (await (await fetch('https://checkip.amazonaws.com')).text()).trim(),
  sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
  log: (m) => console.log(m),
  sock: socketPath(),
  readState,
};

const cmds = { up, down, status };
const name = process.argv[2];
if (name === 'init') {
  const { init } = await import('../src/commands/init.mjs');
  await init(deps);
} else if (cmds[name]) {
  await cmds[name](deps);
} else {
  console.error('usage: remote-browser <init|up|down|status>');
  process.exit(2);
}
